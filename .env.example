# =============================================================================
# logops 环境变量模板（init.sh 会复制为 .env；.env 含凭据，不入库）
# 变量名与取值口径冻结于《表1 接口冻结值》，增删变量需先发接口变更并确认。
# =============================================================================

# 宿主机监听端口（容器内固定 8080）；健康检查走 127.0.0.1:8080
WEB_PORT=8080

# 原始访问日志：nginx combined 格式、UTF-8、一行一条
LOG_FILE=data/logs/access.log
# 模拟日志（数据与巡检负责人交付，供 analyze.sh 调试与手工核对）
SAMPLE_LOG=data/logs/sample_access.log

# 报告输出目录：report.md（六节固定顺序）、summary.csv（表头 section,item,value）
OUT_DIR=out

# TOP-N 页面统计条数
TOP_N=10

# 巡检阈值（check.sh）：磁盘使用率 %、内存使用率 %
DISK_THRESHOLD=80
MEM_THRESHOLD=90

# 巡检告警日志（check.sh 异常时追加写入）
ALERT_LOG=out/alert.log

# -----------------------------------------------------------------------------
# 选做：db 服务凭据（compose.yml 若启用 db 服务才需要）
# 首次生成 .env 时由 init.sh 写入随机值；不启用 db 时留空即可。
# 该键不在冻结清单内，如组内确认不使用 db，可整行删除，脚本会自动兼容。
# -----------------------------------------------------------------------------
DB_PASSWORD=
